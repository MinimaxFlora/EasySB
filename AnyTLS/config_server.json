{
  // 入站协议配置：定义服务器如何接收客户端发来的连接
  "inbounds": [
    {
      "type": "anytls",               // 入站协议类型为 AnyTLS（抗 DPI 深度包检测的 TLS 协议）
      "tag": "anytls",               // 该入站节点的标识标签（用于路由匹配与日志追踪）
      "listen": "::",                 // 监听地址，"::" 表示同时监听所有 IPv4 和 IPv6 网络接口
      "listen_port": 443,             // 监听端口（443 为标准 HTTPS 端口，增强伪装度）
      // 允许连接的授权用户列表
      "users": [
        {
          "name": "sekai",            // 用户标识名称
          "password": "8JCsPssfgS8tiRwiMlhARg==" // 用户身份验证密钥/密码
        }
      ],
      // 数据包填充策略 (Padding Scheme)：通过改变初始数据包大小对抗流量特征分析
      "padding_scheme": [
        "stop=8",                     // 填充在第 8 个数据包发送完毕后停止
        "0=30-30",                    // 第 0 个数据包固定填充 30 字节
        "1=100-400",                  // 第 1 个数据包随机填充 100 至 400 字节
        "2=400-500,c,500-1000,c,500-1000,c,500-1000,c,500-1000", // 第 2 阶段多交互组合填充规则（c 为双向/客户端填充）
        "3=9-9,500-1000",             // 第 3 个数据包分段填充规则
        "4=500-1000",                 // 第 4 个数据包随机填充 500 至 1000 字节
        "5=500-1000",                 // 第 5 个数据包随机填充 500 至 1000 字节
        "6=500-1000",                 // 第 6 个数据包随机填充 500 至 1000 字节
        "7=500-1000"                  // 第 7 个数据包随机填充 500 至 1000 字节
      ],
      // TLS 传输层安全服务端配置
      "tls": {
        "enabled": true,              // 启用 TLS 服务端加密
        "certificate_path": "/root/fullchain.cer", // SSL/TLS 完整证书文件路径
        "key_path": "/root/private.key",           // SSL/TLS 证书私钥文件路径
        "alpn": [                     // 应用层协议协商，用于模拟正常 Web 协议协商响应
          "h3",
          "h2",
          "http/1.1"
        ]
      }
    }
  ],
  // 出站协议配置：定义服务端处理请求后的出口方向
  "outbounds": [
    {
      "type": "direct",               // 直连出站，将流量直接转发至目标服务器
      "tag": "direct"                 // 直连出站节点的标识标签
    }
  ]
}
