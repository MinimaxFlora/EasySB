{
  // 入站协议配置：定义本地客户端接收流量的方式
  "inbounds": [
    {
      "type": "mixed",                  // 混合入站类型，同时支持 HTTP 和 SOCKS5 代理协议
      "listen": "::",                   // 监听地址，"::" 表示监听所有 IPv4 和 IPv6 网络接口
      "listen_port": 10000              // 本地代理监听端口
    }
  ],
  // 出站协议配置：定义流量发往远程服务器的规则
  "outbounds": [
    {
      "type": "anytls",                 // 出站协议类型为 AnyTLS
      "tag": "",                        // 该出站节点的标签名称（用于路由规则引用）
      "server": "",                     // 远程 AnyTLS 服务器地址（域名或 IP）
      "server_port": 443,              // 远程服务器端口
      "password": "你的密码",            // 身份校验密码（需替换为实际密码）
      "idle_session_check_interval": "30s", // 空闲连接/会话检测的时间间隔
      "idle_session_timeout": "30s",    // 会话空闲超时时间，超时后自动释放连接
      "min_idle_session": 5,            // 维持的最少空闲预连接数（用于降低握手延迟，加速连接）
      // TLS 传输层安全配置
      "tls": {
        "alpn": [                       // 应用层协议协商列表（协商优先级按顺序自上而下）
          "h3",
          "h2",
          "http/1.1"
        ],
        "enabled": true,                // 启用 TLS 加密传输
        "server_name": "",              // SNI 验证域名（留空时默认使用 server 字段中的域名）
        // uTLS 客户端指纹伪装配置
        "utls": {
          "enabled": true,              // 启用 uTLS 指纹伪装
          "fingerprint": "chrome"       // 伪装为 Chrome 浏览器的 TLS 握手指纹特征
        }
      }
    }
  ]
}
