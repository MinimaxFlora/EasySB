{
  // 入站协议配置：定义服务器如何接收客户端发来的连接
  "inbounds": [
    {
      "type": "vless",                  // 入站协议类型为 VLESS（服务端）
      "listen": "::",                   // 监听地址，"::" 表示同时监听所有 IPv4 和 IPv6 网络接口
      "listen_port": 443,               // 服务端监听端口（REALITY 规范通常使用 443 端口）
      // 允许连接的授权用户列表
      "users": [
        {
          "uuid": "a9a6e2b5-5e34-4899-9865-f021e27bafc3", // 用户身份验证密钥 UUID（需与客户端保持一致）
          "flow": "xtls-rprx-vision"    // 启用 Vision 流控算法（消解双重 TLS 握手特征与数据包长度特征）
        }
      ],
      // TLS 传输层安全及 REALITY 伪装配置
      "tls": {
        "enabled": true,                // 启用 TLS 服务端加密
        "server_name": "ip",            // 服务端匹配的 SNI 名称（可填写允许的伪装域名或特定标识）
        // REALITY 无证书伪装服务端配置
        "reality": {
          "enabled": true,              // 启用 REALITY 无证书伪装协议
          // 目标偷取/借用证书的真实服务器握手配置
          "handshake": {
            "server": "apple.com",      // 借用证书的真实目标域名（未授权访问将被回源转发至此域名）
            "server_port": 443          // 伪装目标服务器的端口
          },
          "private_key": "SCytw0AxhrG8S2HNArRWsXXM6xZup0HdSOa2OExE9Gc", // REALITY 服务端私钥（Private Key，请妥善保管）
          "short_id": [                 // 允许连接的 Short ID 列表（必须包含客户端配置的 short_id）
            "5b6966df"
          ]
        }
      }
    }
  ],
  // 出站协议配置：定义服务端接收到流量后的去向
  "outbounds": [
    {
      "type": "direct"                 // 直连出站，将客户端请求直接发送到目标网站/服务器
    }
  ]
}
