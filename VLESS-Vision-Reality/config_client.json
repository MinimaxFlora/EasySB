{
  // 入站协议配置：定义客户端如何接收本地流量
  "inbounds": [
    {
      "type": "mixed",                  // 混合入站类型，同时支持 HTTP 和 SOCKS5 代理协议
      "listen": "::",                   // 监听地址，"::" 表示监听所有 IPv4 和 IPv6 网络接口
      "listen_port": 10000              // 本地代理监听端口
    }
  ],
  // 出站协议配置：定义流量发往远程服务器的规则
  "outbounds": [
    {
      "type": "vless",                  // 出站协议类型为 VLESS
      "tag": "vless-vision-reality",    // 该出站节点的标识标签（用于路由规则引用）
      "server": "example.com",          // 远程节点服务器地址
      "server_port": 443,               // 远程服务器端口（REALITY 规范通常使用 443 端口）
      "uuid": "a9a6e2b5-5e34-4899-9865-f021e27bafc3", // 用户身份验证密钥 UUID（必须与服务端配置完全一致）
      "flow": "xtls-rprx-vision",       // 启用 Vision 流控算法（用于消解 TLS 握手特征与长度特征）
      // TLS 传输层安全及 REALITY 伪装配置
      "tls": {
        "enabled": true,                // 启用 TLS 加密传输
        "server_name": "apple.com",     // SNI 目标伪装域名（需与服务端配置的 REALITY 伪装域名保持一致）
        // uTLS 客户端指纹伪装配置
        "utls": {
          "enabled": true,              // 启用 uTLS 客户端指纹伪装
          "fingerprint": "chrome"       // 伪装为 Chrome 浏览器的 TLS 握手指纹特征
        },
        // REALITY 协议扩展配置
        "reality": {
          "enabled": true,              // 启用 REALITY 无证书伪装协议
          "public_key": "jgcVPebui9A55ultlIF0VuESK8eMi9A0v24-wrYBpzU", // REALITY 服务端公钥（Public Key）
          "short_id": "5b6966df"        // REALITY 简短标识符（Short ID，需与服务端匹配）
        }
      },
      "packet_encoding": "xudp"         // UDP 数据包编码格式（使用 xudp 可大幅提升 UDP 传输效率与游戏体验）
    }
  ]
}
