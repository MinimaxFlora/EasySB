#!/usr/bin/env bash
# wget stub —— 同 curl：只有 fixture 覆盖的 URL 可用，其余失败（exit 8），绝不联网
printf '%s\t%s\n' "${0##*/}" "$*" >>"${ESB_TEST_WORK:-/dev/null}/stubs.log" 2>/dev/null || true
_t="${ESB_TESTS_DIR:-$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)}"
_wg_out="" _wg_url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -O|--output-document) _wg_out="${2-}"; shift 2 ;;
    --timeout=*|--tries=*|-T) shift ;;
    --timeout|--tries) shift 2 ;;
    -*) shift ;;
    *) _wg_url="$1"; shift ;;
  esac
done
_wg_fx=""
case "$_wg_url" in
  *api.github.com/repos/*/releases/*) _wg_fx="$_t/fixtures/release-latest.json" ;;
esac
if [ -z "$_wg_fx" ] || [ ! -f "$_wg_fx" ]; then
  printf 'wget: 无法获取 "%s"（沙箱无 fixture，ESB_OFFLINE=1：禁止真联网）\n' "$_wg_url" >&2
  exit 8
fi
if [ -n "$_wg_out" ] && [ "$_wg_out" != "-" ]; then
  cat "$_wg_fx" >"$_wg_out" || exit 3
else
  cat "$_wg_fx"
fi
exit 0
