#!/usr/bin/env bash
# curl stub —— 沙箱内永不联网：api.github.com/repos/*/releases/* 走 tests/fixtures/release-latest.json，未知 URL 直接失败（exit 22）
printf '%s\t%s\n' "${0##*/}" "$*" >>"${ESB_TEST_WORK:-/dev/null}/stubs.log" 2>/dev/null || true
_t="${ESB_TESTS_DIR:-$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)}"
_cu_out="" _cu_url="" _cu_w=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o|--output) _cu_out="${2-}"; shift 2 ;;
    -w|--write-out) _cu_w="${2-}"; shift 2 ;;
    --connect-timeout|--max-time|--retry|--retry-delay|--retry-max-time|--header|-H|--proxy|-x|--user-agent|-A|--output-dir|--data|-d) shift 2 ;;
    -*) shift ;;
    *) _cu_url="$1"; shift ;;
  esac
done
_cu_fx=""
case "$_cu_url" in
  *api.github.com/repos/*/releases/*) _cu_fx="$_t/fixtures/release-latest.json" ;;
esac
if [ -z "$_cu_fx" ] || [ ! -f "$_cu_fx" ]; then
  printf 'curl: (22) 沙箱里没有 "%s" 的 fixture（ESB_OFFLINE=1：禁止真联网）\n' "$_cu_url" >&2
  exit 22
fi
if [ -n "$_cu_out" ] && [ "$_cu_out" != "-" ]; then
  cat "$_cu_fx" >"$_cu_out" || exit 23
else
  cat "$_cu_fx"
fi
[ -n "$_cu_w" ] && printf '%s' "$_cu_w" | sed 's/%{[a-zA-Z_]*}/200/g'
exit 0
