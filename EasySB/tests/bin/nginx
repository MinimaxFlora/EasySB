#!/usr/bin/env bash
# nginx stub —— 记录调用；`-t` 只在 `-c <file>` 指定的配置不存在时失败（能真报错），其余动作成功
printf '%s\t%s\n' "${0##*/}" "$*" >>"${ESB_TEST_WORK:-/dev/null}/stubs.log" 2>/dev/null || true
case "${1:-}" in
  -t|--test)
    _n_c=""; _n_prev=""
    for _n_a in "$@"; do [ "$_n_prev" = "-c" ] && _n_c="$_n_a"; _n_prev="$_n_a"; done
    if [ -n "$_n_c" ] && [ ! -f "$_n_c" ]; then
      printf 'nginx: [emerg] open() "%s" failed (No such file or directory)\n' "$_n_c" >&2
      exit 1
    fi
    printf 'nginx: configuration file %s test is successful\n' "${_n_c:-/etc/nginx/nginx.conf}"
    exit 0
    ;;
  -v|-V) printf 'nginx version: nginx/1.24.0 (EasySB stub)\n'; exit 0 ;;
  -s)    exit 0 ;;
  '')    printf 'nginx stub: 缺少参数\n' >&2; exit 1 ;;
  *)     exit 0 ;;
esac
