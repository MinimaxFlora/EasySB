#!/usr/bin/env bash
# ip stub —— 记录调用；addr 输出固定本机 IP（ESB_STUB_LOCAL_IP，默认 203.0.113.10），route get 输出带 src 的行
printf '%s\t%s\n' "${0##*/}" "$*" >>"${ESB_TEST_WORK:-/dev/null}/stubs.log" 2>/dev/null || true
_ip="${ESB_STUB_LOCAL_IP:-203.0.113.10}"
case "$*" in
  *route*) printf '1.1.1.1 via 203.0.113.1 dev eth0 src %s uid 0\n' "$_ip" ;;
  *addr*|*" a "*) printf '2: eth0    inet %s/24 brd 203.0.113.255 scope global eth0\n' "$_ip" ;;
  -o|-4|-6|"") ;;
  *) exit 0 ;;
esac
exit 0
