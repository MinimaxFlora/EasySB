#!/usr/bin/env bash
# systemctl stub —— 记录调用到 $ESB_TEST_WORK/stubs.log；is-active 打印 $ESB_STUB_ACTIVE（默认 active，否则 exit 3），其余动作成功
printf '%s\t%s\n' "${0##*/}" "$*" >>"${ESB_TEST_WORK:-/dev/null}/stubs.log" 2>/dev/null || true
case "${1:-}" in
  is-active)
    printf '%s\n' "${ESB_STUB_ACTIVE:-active}"
    [ "${ESB_STUB_ACTIVE:-active}" = "active" ] && exit 0
    exit 3
    ;;
  is-enabled) printf 'enabled\n'; exit 0 ;;
  status)     printf '\342\227\217 sing-box.service - EasySB stub\n   Active: %s\n' "${ESB_STUB_ACTIVE:-active}"; exit 0 ;;
  show)       printf 'ActiveState=%s\n' "${ESB_STUB_ACTIVE:-active}"; exit 0 ;;
  start|stop|restart|reload|enable|disable|daemon-reload) exit 0 ;;
  '') printf 'systemctl stub: 缺少子命令\n' >&2; exit 1 ;;
  *) printf 'systemctl stub: 未处理的子命令 "%s"\n' "$1" >&2; exit 1 ;;
esac
