#!/usr/bin/env bash
# useradd stub —— 记录调用；默认成功（exit 0），ESB_STUB_USERADD_EXISTS=1 时按"用户已存在"失败（exit 9）
printf '%s\t%s\n' "${0##*/}" "$*" >>"${ESB_TEST_WORK:-/dev/null}/stubs.log" 2>/dev/null || true
if [ "${ESB_STUB_USERADD_EXISTS:-0}" = "1" ]; then
  printf 'useradd: user "%s" already exists\n' "${*: -1}" >&2
  exit 9
fi
exit 0
