#!/usr/bin/env bash
# getent stub —— 记录调用；默认解析不到任何名字（exit 2，能"报空"），设 ESB_STUB_GETENT_IP 才模拟解析成功
printf '%s\t%s\n' "${0##*/}" "$*" >>"${ESB_TEST_WORK:-/dev/null}/stubs.log" 2>/dev/null || true
case "${1:-}" in
  ahostsv4|ahosts|hosts)
    [ -n "${ESB_STUB_GETENT_IP:-}" ] || exit 2
    printf '%s  STREAM %s\n' "$ESB_STUB_GETENT_IP" "${2:-}"
    printf '%s  DGRAM  %s\n' "$ESB_STUB_GETENT_IP" "${2:-}"
    printf '%s  RAW    %s\n' "$ESB_STUB_GETENT_IP" "${2:-}"
    exit 0
    ;;
  passwd|group) exit 2 ;;
  *) exit 2 ;;
esac
