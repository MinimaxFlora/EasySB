#!/usr/bin/env bash
# nft stub —— 记录调用；`list` 一律输出空（能"报空"），拒绝 `flush ruleset`（INTERFACES §0.3 禁止清空规则集）
printf '%s\t%s\n' "${0##*/}" "$*" >>"${ESB_TEST_WORK:-/dev/null}/stubs.log" 2>/dev/null || true
case "$*" in
  *flush*ruleset*)
    printf 'nft stub: 拒绝 "flush ruleset"（违反 INTERFACES §0.3：禁止清空防火墙规则集）\n' >&2
    exit 1
    ;;
esac
case "${1:-}" in
  list) exit 0 ;;
  add|delete|insert|create) exit 0 ;;
  '') printf 'nft stub: 缺少参数\n' >&2; exit 1 ;;
  *) exit 0 ;;
esac
