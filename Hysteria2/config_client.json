{
  // 入站协议配置：定义客户端如何接收本地流量
  "inbounds": [
    {
      "type": "mixed",                  // 混合入站类型，同时支持 HTTP 和 SOCKS5 代理协议
      "listen": "::",                   // 监听地址，"::" 表示监听所有 IPv4 和 IPv6 网络接口
      "listen_port": 10000              // 本地代理监听端口
    }
  ],
  // 出站协议配置：定义流量发往远程服务器的规则
  "outbounds": [
    {
      "type": "hysteria2",              // 出站协议类型为 Hysteria 2（基于 QUIC/UDP 的高性能协议）
      "tag": "hysteria2",               // 该出站节点的标识标签（用于路由规则引用）
      "server": "example.com",          // 远程服务器域名或 IP 地址
      "server_port": 443,               // 远程服务器默认主端口，与下面的端口跳跃二选一
      "server_ports":["2080:3000"],     // 允许在 2080 到 3000 端口范围内动态切换
      "hop_interval": "30s",            // 端口跳跃时间间隔，每 30 秒自动切换一次发包端口
      "up_mbps": 20,                    // 客户端最大上行带宽（Mbps），用于拥塞控制算法估算
      "down_mbps": 100,                 // 客户端最大下行带宽（Mbps），用于拥塞控制算法估算
      "password": "8JCsPssfgS8tiRwiMlhARg==", // 用户认证密码
      // TLS 传输层安全配置（Hysteria 2 必须启用 TLS）
      "tls": {
        "enabled": true,                // 启用 TLS 加密传输
        "server_name": "example.com",   // SNI 域名，用于 TLS 握手及证书校验
        "alpn": [                       // 应用层协议协商，Hysteria 2 必须协商为 h3
          "h3"
        ]
      }
    }
  ]
}

# 在 IPv4 协议栈中创建名为 "nat" 的表（若已存在可忽略）
# 在 nat 表中创建 PREROUTING 预处理链，用于在数据包进入路由判断前修改其目标地址/端口
# 添加 NAT 重定向规则：将发往 UDP 2080 至 3000 端口范围的所有流量，全额转发给本地实际监听的 443 端口
nft add table ip nat
nft 'add chain ip nat prerouting { type nat hook prerouting priority dstnat; }'
nft add rule ip nat prerouting udp dport 2080-3000 redirect to :443

# 在 nat 表的 PREROUTING 链追加规则：
# -p udp: 匹配 UDP 协议（Hysteria 2 基于 QUIC/UDP）
# --dport 2080:3000: 匹配客户端发往服务端的 2080 到 3000 目标端口范围
# -j REDIRECT --to-ports 443: 将匹配到的流量直接重定向至服务端本地的 443 端口
iptables -t nat -A PREROUTING -p udp --dport 2080:3000 -j REDIRECT --to-ports 443
