{
  // 入站协议配置：定义服务器如何接收客户端发来的连接
  "inbounds": [
    {
      "type": "hysteria2",              // 入站协议类型为 Hysteria 2（基于 QUIC/UDP 的服务端协议）
      "tag": "hysteria2",               // 该入站节点的标识标签（用于路由匹配与日志追踪）
      "listen": "::",                   // 监听地址，"::" 表示同时监听所有 IPv4 和 IPv6 网络接口
      "listen_port": 443,               // 服务端监听端口（使用 443 标准 HTTPS 端口以提高伪装度）
      "up_mbps": 100,                   // 服务端最大上行带宽（Mbps），用于 BBR/QUIC 拥塞控制估算
      "down_mbps": 20,                  // 服务端最大下行带宽（Mbps），用于 BBR/QUIC 拥塞控制估算
      // 允许连接的授权用户列表
      "users": [
        {
          "name": "tobyxdd",            // 用户标识名称
          "password": "8JCsPssfgS8tiRwiMlhARg==" // 用户认证密码
        }
      ],
      // TLS 传输层安全服务端配置（Hysteria 2 必须配置）
      "tls": {
        "enabled": true,                // 启用 TLS 服务端加密
        "alpn": [                       // 应用层协议协商，Hysteria 2 必须固定协商为 h3
          "h3"
        ],
        "certificate_path": "/root/fullchain.cer", // SSL/TLS 证书完整链文件路径
        "key_path": "/root/private.key"            // SSL/TLS 证书私钥文件路径
      }
    }
  ],
  // 出站协议配置：定义服务端接收到流量后的去向
  "outbounds": [
    {
      "type": "direct",                 // 直连出站，将客户端请求直接发送到目标网站/服务器
      "tag": "direct"                   // 直连出站节点的标识标签
    }
  ]
}
