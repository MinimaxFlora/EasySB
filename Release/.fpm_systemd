-s dir
--name sing-box
--category net
--license GPL-3.0-or-later
--description "The universal proxy platform."
--url "https://sing-box.sagernet.org/"
--vendor SagerNet
--maintainer "nekohasekai <contact-git@sekai.icu>"
--deb-field "Bug: https://github.com/SagerNet/sing-box/issues"
--no-deb-generate-changes
--config-files /etc/sing-box/config.json
--after-install Release/sing-box.postinst

Templates/tun-fakeip.json=/etc/sing-box/config.json

Release/sing-box.service=/usr/lib/systemd/system/sing-box.service
Release/sing-box@.service=/usr/lib/systemd/system/sing-box@.service
Release/sing-box.sysusers=/usr/lib/sysusers.d/sing-box.conf
Release/sing-box.rules=/usr/share/polkit-1/rules.d/sing-box.rules
Release/sing-box-split-dns.xml=/usr/share/dbus-1/system.d/sing-box-split-dns.conf

Release/sing-box.bash=/usr/share/bash-completion/completions/sing-box.bash
Release/sing-box.fish=/usr/share/fish/vendor_completions.d/sing-box.fish
Release/sing-box.zsh=/usr/share/zsh/site-functions/_sing-box

Release/LICENSE=/usr/share/licenses/sing-box/LICENSE
