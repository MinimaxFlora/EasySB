{
  // 入站协议配置：定义服务端如何接收客户端发来的连接
  "inbounds": [
    {
      "type": "tuic",                   // 入站协议类型为 TUIC (基于 QUIC/UDP 的高性能传输协议)
      "tag": "tuic",                    // 入站节点的标识标签（用于路由匹配与日志追踪）
      "listen": "::",                   // 监听地址，"::" 表示同时监听所有 IPv4 和 IPv6 网络接口
      "listen_port": 443,               // 服务端监听端口（通常使用 443 端口以伪装成标准 HTTPS/QUIC 流量）
      // 允许连接的授权用户列表
      "users": [
        {
          "uuid": "a9a6e2b5-5e34-4899-9865-f021e27bafc3", // 用户身份验证 UUID（需与客户端保持一致）
          "password": "hello"           // 用户认证密码（需与客户端保持一致）
        }
      ],
      "congestion_control": "bbr",      // QUIC 拥塞控制算法（常用 bbr，可在高丢包高延迟网络中提升吞吐量；可选: cubic, new_reno）
      "auth_timeout": "3s",             // 身份认证超时时间（客户端连接后 3 秒内未完成认证则直接断开）
      "zero_rtt_handshake": false,      // 是否开启 0-RTT 快速握手（false 可提升防重放攻击安全性；true 可降低建立连接延迟）
      "heartbeat": "10s",               // 发送心跳包的时间间隔（用于维持长连接与检测链路是否中断）
      // TLS 传输层安全服务端配置（TUIC 协议基于 QUIC，必须开启 TLS）
      "tls": {
        "enabled": true,                // 启用 TLS 加密
        "alpn": [                       // 应用层协议协商（ALPN），通常填 h3 (HTTP/3)
          "h3"
        ],
        "certificate_path": "/root/fullchain.cer", // SSL/TLS 证书完整链文件绝对路径
        "key_path": "/root/private.key"            // SSL/TLS 证书私钥文件绝对路径
      }
    }
  ],
  // 出站协议配置：定义服务端接收到流量后的去向
  "outbounds": [
    {
      "type": "direct"                 // 直连出站，将客户端解密后的请求直接发送至目标网站或服务器
    }
  ]
}
