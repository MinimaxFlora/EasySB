{
  // 入站协议配置：定义本地客户端如何接收应用程序的代理连接
  "inbounds": [
    {
      "type": "mixed",                  // 混合入站类型，同时支持 HTTP 和 SOCKS5 代理协议
      "listen": "::",                   // 监听地址，"::" 表示监听所有 IPv4 和 IPv6 本地网络接口
      "listen_port": 10000              // 本地代理服务监听的端口
    }
  ],
  // 出站协议配置：定义流量发往远程代理服务器的规则
  "outbounds": [
    {
      "type": "tuic",                   // 出站协议类型为 TUIC（客户端）
      "tag": "tuic",                    // 该出站节点的标识标签（用于路由规则匹配）
      "server": "example.com",           // 远程 TUIC 服务器地址（需填写 VPS 的 IP 地址或域名）
      "server_port": 443,               // 远程服务器监听端口（通常为 443）
      "uuid": "a9a6e2b5-5e34-4899-9865-f021e27bafc3", // 用户身份验证密钥 UUID（需与服务端匹配）
      "password": "hello",              // 用户认证密码（需与服务端匹配）
      "congestion_control": "bbr",      // QUIC 拥塞控制算法（常用 bbr，可大幅优化高丢包与高延迟链路）
      "udp_relay_mode": "native",       // UDP 转发模式（native: 原生 UDP 包转发，性能最高且延迟最低）
      "udp_over_stream": false,         // 是否开启 UDP Over Stream（false 表示直传 UDP，true 表示将 UDP 转化为 QUIC 流传输）
      "zero_rtt_handshake": false,      // 是否开启 0-RTT 快速握手（false 提高防重放攻击安全性；true 可加快建立连接）
      "heartbeat": "10s",               // 保活心跳包发送间隔（用于维持长连接与检测链路连通性）
      "network": "tcp",                 // 传输网络类型（TUIC 内部用于标示请求的传输承载方式）
      // TLS 传输层安全配置（TUIC 必须配置）
      "tls": {
        "enabled": true,                // 开启 TLS 加密传输
        "server_name": "example.com",   // TLS 握手 SNI 验证域名（需与服务端证书域名一致）
        "alpn": [                       // 应用层协议协商（TUIC 基于 QUIC，需填入 h3）
          "h3"
        ]
      }
    }
  ]
}
