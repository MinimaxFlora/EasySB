{
  // 入站协议配置：定义客户端如何接收本地流量
  "inbounds": [
    {
      "type": "mixed",          // 混合入站类型，同时支持 HTTP 和 SOCKS5 代理协议
      "listen": "::",           // 监听地址，"::" 表示监听所有 IPv4 和 IPv6 网络接口
      "listen_port": 10000      // 本地代理监听端口
    }
  ],
  // 出站协议配置：定义流量如何发往远程服务器
  "outbounds": [
    {
      "type": "vmess",          // 出站协议类型为 VMess
      "server": "",             // 节点服务器地址（域名或 IP，需填写）
      "server_port": 443,       // 节点服务器端口（通常 TLS 为 443）
      "uuid": "",               // 用户 UUID 身份校验密钥（需填写）
      "security": "auto",       // 加密方式，auto 为自动选择（推荐）
      "alter_id": 0,            // VMess 变种 ID，现代节点通常设为 0
      "global_padding": false,  // 是否开启全局填充
      "authenticated_length": true, // 是否对数据包长度进行认证处理（防探测）
      // TLS 传输层安全配置
      "tls": {
        "enabled": true,        // 启用 TLS 加密
        "server_name": "",      // SNI 域名，用于 TLS 握手及证书校验（通常填节点域名）
        // uTLS 指纹伪装配置
        "utls": {
          "enabled": true,      // 启用 uTLS 客户端指纹伪装
          "fingerprint": "chrome" // 伪装为 Chrome 浏览器的 TLS 握手特征
        }
      },
      "packet_encoding": "packetaddr", // VMess 数据包编码方式（优化 UDP 传输）
      // 多路复用配置 (Mux)
      "multiplex": {
        "enabled": true,        // 启用多路复用，降低并发连接建立时的延迟
        "protocol": "smux",     // 多路复用协议类型（常用 smux、h2mux、yamux）
        "max_connections": 4,   // 允许建立的最大底层 TCP 物理连接数量
        "min_streams": 4,       // 单个物理连接最少承载的流数量（达到后才创建新的物理连接）
        "max_streams": 0,       // 单个物理连接允许承载的最大流数量（0 表示不限制）
        "padding": false        // 是否对 Mux 数据包启用随机填充（防流量特征分析）
      },
      // 传输层协议扩展配置
      "transport": {
        "type": "ws",           // 使用 WebSocket 传输协议
        "path": "/vmess",       // WebSocket HTTP 请求路径（需与服务端配置一致）
        "max_early_data": 2048, // 0-RTT 早期数据传输的最大字节数
        "early_data_header_name": "Sec-WebSocket-Protocol" // 传输早期数据的 HTTP Header 名称
      }
    }
  ]
}
