{
  // 入站协议配置：定义服务器如何接收客户端发来的连接
  "inbounds": [
    {
      "type": "vmess",                 // 入站协议类型为 VMess（服务端）
      "tag": "vmess-ws-tls",           // 该入站节点的标识标签（用于路由规则与日志引用）
      "listen": "::",                  // 监听地址，"::" 表示同时监听所有 IPv4 和 IPv6 网络接口
      "listen_port": 443,              // 服务端监听端口（设置为 443 标准 HTTPS 端口）
      // 允许连接的用户列表
      "users": [
        {
          "uuid": "a9a6e2b5-5e34-4899-9865-f021e27bafc3", // 用户身份验证密钥 UUID（必须与客户端保持一致）
          "alterId": 0                 // VMess 额外 ID，现代 VMess AEAD 规范要求固定设为 0
        }
      ],
      // 传输层协议扩展配置
      "transport": {
        "type": "ws",                  // 传输协议使用 WebSocket
        "path": "/vmess",              // WebSocket 分流路径（必须与反向代理和客户端配置完全一致）
        "max_early_data": 2048,        // WebSocket 0-RTT 早期数据的最大字节数
        "early_data_header_name": "Sec-WebSocket-Protocol" // 承载早期数据的 HTTP 请求头名称
      },
      // TLS 传输层安全服务端配置
      "tls": {
        "enabled": true,               // 启用 TLS 服务端加密
        "certificate_path": "/root/fullchain.cer", // SSL/TLS 证书完整链文件路径
        "key_path": "/root/private.key"            // SSL/TLS 证书私钥文件路径
      }
    }
  ],
  // 出站协议配置：定义服务器接收到流量后的去向
  "outbounds": [
    {
      "type": "direct",                // 直连出站，将客户端请求直接发送到目标网站/服务器
      "tag": "direct"                  // 直连出站节点的标识标签
    }
  ]
}
