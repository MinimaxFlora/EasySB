{
  // 入站协议配置：定义服务器如何接收客户端发来的连接
  "inbounds": [
    {
      "type": "vmess",                 // 入站协议类型为 VMess（服务端）
      "tag": "",                       // 该出站节点的标签名称（用于路由规则引用）
      "listen": "127.0.0.1",           // 监听地址，127.0.0.1 表示仅监听本地（通常配合 Nginx/Caddy 等 Web 服务器进行反向代理）
      "listen_port": 8001,             // 本地服务端监听端口
      // 允许连接的用户列表
      "users": [
        {
          "uuid": "",                  // 用户身份验证密钥 UUID（需自行生成并填写，与客户端保持一致）
          "alterId": 0                 // VMess 额外 ID，现代 VMess AEAD 规范要求固定设为 0
        }
      ],
      // 多路复用配置 (Mux)
      "multiplex": {
        "enabled": true,               // 启用多路复用支持，允许客户端在单个连接中传输多个请求
        "protocol": "smux",            // 多路复用传输协议类型
        "max_connections": 4,          // 允许客户端建立的最大并发 TCP 物理连接数
        "min_streams": 4,              // 单条物理连接包含的最少数据流数量
        "max_streams": 0,              // 单条物理连接允许的最大数据流数量（0 表示不限制）
        "padding": false               // 是否开启数据包随机填充（关闭可稍微降低 CPU 开销）
      },
      // 传输层协议扩展配置
      "transport": {
        "type": "ws",                  // 传输协议使用 WebSocket
        "path": "/vmess",              // WebSocket 分流路径（需与反向代理和客户端路径完全一致）
        "max_early_data": 2048,        // WebSocket 0-RTT 早期数据的最大字节数
        "early_data_header_name": "Sec-WebSocket-Protocol" // 承载早期数据的 HTTP 请求头名称
      }
    }
  ],
  // 出站协议配置：定义服务器接收到流量后的去向
  "outbounds": [
    {
      "type": "direct"                 // 直连出站，将客户端请求直接发送到目标网站/服务器
    }
  ]
}
