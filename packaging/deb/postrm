#!/bin/sh
# Drop the unit cache entry that pointed at the removed files. `remove` keeps the
# panel's own state under /etc/sing-box untouched, the same way `apt remove` keeps
# a removed program's configuration.
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
